# Copie para .env no servidor da Hostinger e preencha com seus dados.
# Não coloque este arquivo em repositório público.

# Banco MySQL (hPanel > Bancos de dados MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=u000000000_chope
MYSQL_PASSWORD=sua-senha-do-banco
MYSQL_DATABASE=u000000000_chopecontrol

# Chave usada para assinar o login (gere uma frase longa e aleatória)
AUTH_SECRET=troque-por-uma-frase-longa-e-aleatoria

# Pasta onde as fotos dos romaneios ficam salvas
UPLOAD_DIR=./uploads

# Porta do aplicativo Node (a Hostinger normalmente define automaticamente)
PORT=3000
